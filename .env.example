SIRIUS_ENVIRONMENT=development
POSTGRES_PASSWORD=replace-with-a-long-random-secret
SIRIUS_DATABASE_URL=postgresql+psycopg://sirius:change-me@postgres:5432/sirius
SIRIUS_REDIS_URL=redis://redis:6379/0
SIRIUS_STORAGE_PATH=/app/storage
SIRIUS_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SIRIUS_DEFAULT_SIMULATIONS=100000
SIRIUS_SIMULATION_WORKERS=2
SIRIUS_MODEL_VERSION=0.4.0
SIRIUS_API_KEY=replace-with-a-long-random-secret
SIRIUS_ALLOW_REMOTE_COMPUTE=true
SIRIUS_LOCAL_RESULT_MAX_BYTES=67108864
SIRIUS_PUBLIC_URL=https://sirius-engine-ilan-2030.fly.dev
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
SIRIUS_INTERNAL_API_URL=http://api:8000/api/v1
